{
  "name": "nexocv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "pnpm run build && pnpm run test:unit",
    "test:unit": "node --import=./tests/support/register-hooks.mjs --experimental-strip-types --test --test-isolation=none tests/matcher.test.mjs tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:unit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "mammoth": "1.10.0",
    "pdfjs-dist": "5.4.149",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vinext": "1.0.0-beta.12",
    "vite": "8.3.1",
    "wrangler": "4.140.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
